############################################################
#  KnowledgeDesk v1 — Configuration
#  Every knob lives here. Defaults work out of the box —
#  you don't need to change anything to demo.
#
#  SECRETS: any value below (and any stored connector/SSO
#  secret field) may be a reference instead of a literal:
#     ${env:NAME}   ${file:/run/secrets/x}
#     ${vault:secret/data/kd#key}   ${awssm:kd/prod/smtp}
#     ${gcpsm:projects/p/secrets/s/versions/latest}
#     ${azkv:https://v.vault.azure.net/secrets/kd-smtp}
#  Append |fallback for a default. See docs/SECRETS_MANAGEMENT.md.
############################################################
SECRETS_CACHE_TTL=300

# ── Identity ────────────────────────────────────────────────
APP_NAME=KnowledgeDesk
ENVIRONMENT=demo                      # demo | production

# ── Security ────────────────────────────────────────────────
ADMIN_API_KEY=kd-admin-key            # legacy X-Admin-Key (disabled unless AUTH_LEGACY_ADMIN_KEY_ENABLED)
DEMO_TENANT_ENABLED=true              # auto-creates a "demo" tenant at startup
DEMO_TENANT_API_KEY=kd-demo-key       # key the UI uses by default

# ── Default accounts (first boot only) — see DEFAULT_USERS_AND_PASSWORDS.md ──
SUPERADMIN_EMAIL=superadmin@knowledgedesk.local
SUPERADMIN_PASSWORD=Superadmin!Kd1
SUPERADMIN_FORCE_PASSWORD_CHANGE=false     # true → prompt on first login
DEMO_USERS_ENABLED=true                    # demo tenant_admin + member
DEMO_ADMIN_EMAIL=admin@demo.knowledgedesk.local
DEMO_ADMIN_PASSWORD=TenantAdmin!Kd1
DEMO_MEMBER_EMAIL=member@demo.knowledgedesk.local
DEMO_MEMBER_PASSWORD=Member!Kd1234

# KEK (key-encryption key) for encryption at rest — see docs/ENCRYPTION_AT_REST.md.
# Wraps the data key that encrypts: connector/MFA/SSO secrets, the Q&A transcript
# (query_log), audit detail, and document chunk text in Qdrant.
# Blank for local/demo → auto-generated to {DATA_DIR}/secret.key.
# Production: supply from a KMS / Vault. Rotation: set "NEW_KEY,OLD_KEY" (comma
# list; first encrypts, all decrypt), deploy, then run
#   docker compose exec app python -m scripts.reencrypt_at_rest --rewrap
KD_SECRET_KEY=

# ── Model profile defaults ─────────────────────────────────
# Tenant admins can change this from Settings in the UI.
# premium_best | enterprise_balanced | multilingual_efficient | demo_fast | extractive_zero_llm
MODEL_PROFILE=demo_fast

# ── LLM (answer generation) ─────────────────────────────────
# provider: ollama (local, free) | openai_compatible (any hosted endpoint) | none (extractive answers, no LLM)
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b                   # Balanced: gemma3:12b. Premium/GPU: gemma3:27b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=300                  # MacBook CPU can take longer on first generation
LLM_FALLBACK_TO_EXTRACTIVE=true       # retrieval fallback stays available, but UI now explains the exact LLM issue
OLLAMA_AUTO_PULL_SAFE_MODELS=true     # auto-pull laptop-safe Ollama models if missing
ALLOW_LARGE_OLLAMA_MODELS=false      # true only when you intentionally run 12B/27B+ models

# Only needed when LLM_PROVIDER=openai_compatible (works with OpenAI, Groq, Together, vLLM, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Embeddings ──────────────────────────────────────────────
# provider: local (free, baked into the image) | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2  # Demo-safe. Enterprise: BAAI/bge-m3
EMBEDDING_BATCH_SIZE=64
ALLOW_HEAVY_LOCAL_MODELS=false        # true only on GPU boxes for Qwen 4B embedding/reranker
AUTO_DOWNGRADE_BLOCKED_MODELS=true    # existing premium tenant settings are reset to demo_safe unless heavy models allowed
LAPTOP_SAFE_MODE=true                 # MacBook/16GB safe mode: no optional reranker downloads by default
ALLOW_RERANKER_MODELS=false           # true only when you accept CrossEncoder download/load latency
HF_TOKEN=                             # optional; improves Hugging Face downloads/rate limits

# ── Reranking ───────────────────────────────────────────────
RERANKER_ENABLED=false
RERANKER_MODEL=
RERANK_TOP_K=0

# ── Retrieval ───────────────────────────────────────────────
RETRIEVAL_TOP_K=12                    # first-stage vector retrieval pool
RETRIEVAL_SCORE_THRESHOLD=0.28        # below this similarity → "not found" (logged as a knowledge gap)
RETRIEVAL_MAX_CONTEXT_CHARS=9000     # hard cap on context size

# ── Chunking ────────────────────────────────────────────────
CHUNK_SIZE=1100                       # characters per chunk
CHUNK_OVERLAP=180
MAX_UPLOAD_MB=50

# ── Performance: DB pool, caching, response-time targets ────
# See docs/PERFORMANCE.md.
DATABASE_URL=                                       # blank → sqlite at {DATA_DIR}/knowledgedesk.db
DB_POOL_SIZE=5                                      # applies to a networked DB (Postgres)
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
SQLITE_CACHE_MB=16                                  # per-connection page cache
TENANT_CONFIG_CACHE_TTL=30                          # seconds to cache resolve_model_config() per tenant; 0 disables
HTTP_POOL_MAX_CONNECTIONS=100                       # shared outbound httpx client
HTTP_POOL_MAX_KEEPALIVE=20
SLO_API_P95_MS=500                                  # p95 budget: non-RAG API requests
SLO_RAG_ANSWER_P95_MS=15000                         # p95 budget: end-to-end grounded answer
SLO_INGEST_DOC_P95_MS=60000                         # p95 budget: per-document ingestion

# ── Resilience: timeouts / retries / idempotency / recovery ─
# See docs/RESILIENCE.md.
REQUEST_TIMEOUT_SECONDS=60                          # hard per-request ceiling → 504; 0 disables
REQUEST_TIMEOUT_EXEMPT_PREFIXES=/api/query/ask/stream   # comma list (SSE etc.)
RETRY_MAX_ATTEMPTS=3                                # transient-failure retries (vector store, remote embeds, connectors)
RETRY_BASE_DELAY_MS=200
RETRY_MAX_DELAY_MS=3000
IDEMPOTENCY_ENABLED=true                            # honour the Idempotency-Key header on mutating requests
IDEMPOTENCY_TTL_HOURS=24
RECOVERY_STUCK_MINUTES=30                           # startup reconciler: age past which 'processing'/'running' = interrupted
SQLITE_BUSY_TIMEOUT_MS=5000                         # wait for a write lock before 'database is locked'
BACKUP_DIR=                                         # default {DATA_DIR}/backups (scripts/backup.py)

# ── Answer behaviour ────────────────────────────────────────
ANSWER_LANGUAGE=auto                  # auto = mirror the question's language, or force e.g. "English"
ANSWER_REFUSE_OUTSIDE_KNOWLEDGE=true  # LLM must say "I don't know" instead of inventing
ANSWER_INCLUDE_CITATIONS=true

# ── Data connectors ────────────────────────────────────────
# Per-workspace connectors (Google Drive service account, SharePoint) are now
# configured from the app: Administration → Data connectors. Credentials are
# encrypted at rest with KD_SECRET_KEY. The variables below are the LEGACY,
# GLOBAL, single-tenant fallback only — leave blank unless you rely on it.
GDRIVE_ACCESS_TOKEN=                  # legacy: short-lived OAuth token, expires in ~1h
GDRIVE_FOLDER_ID=

MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_SITE_ID=                      # e.g. contoso.sharepoint.com,guid,guid
MSGRAPH_DRIVE_ID=                     # optional; default document library used if blank

# ── Infrastructure (set by docker-compose; rarely touched) ──
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
DATA_DIR=/data

# ── Authentication hardening ───────────────────────────────
# Session lifetime (enforced across refresh-token rotation)
AUTH_SESSION_IDLE_HOURS=72               # no refresh within this window → re-login
AUTH_SESSION_MAX_DAYS=30                 # absolute cap; a session cannot outlive this
AUTH_MAX_SESSIONS_PER_USER=10            # oldest chain evicted past this
# Login throttling (sliding window, in-process). Complements per-account lockout.
AUTH_LOGIN_RATE_PER_MIN=12               # per (ip + email)
AUTH_LOGIN_RATE_IP_PER_MIN=60            # per ip, all accounts
# Password policy (PASSWORD_MIN_LENGTH still applies)
AUTH_PW_REQUIRE_UPPER=false
AUTH_PW_REQUIRE_LOWER=false
AUTH_PW_REQUIRE_DIGIT=false
AUTH_PW_REQUIRE_SYMBOL=false
AUTH_PW_HISTORY=5                        # reject reuse of the last N
AUTH_PW_BREACH_CHECK=false               # Have I Been Pwned k-anonymity (keyless)
AUTH_PW_MAX_AGE_DAYS=0                    # 0 = no expiry; >0 forces a change past this age
# MFA (TOTP)
AUTH_TOTP_ISSUER=KnowledgeDesk
AUTH_MFA_TOKEN_MINUTES=5
# Legacy X-Admin-Key bypass — off by default
AUTH_LEGACY_ADMIN_KEY_ENABLED=false
# Optional: also set the refresh token as an httpOnly cookie (needs explicit CORS origins)
AUTH_REFRESH_COOKIE=false
AUTH_COOKIE_SECURE=true
CORS_ALLOW_ORIGINS=*                     # comma list; "*" = any

# ── TLS / reverse proxy ────────────────────────────────────
# Caddy (docker-compose `caddy` service) terminates TLS on :443 and proxies to
# the app/web containers. See docs/DEPLOYMENT_TLS.md.
KD_DOMAIN=localhost                      # localhost → Caddy local CA; a real FQDN → Let's Encrypt
KD_TLS_EMAIL=admin@example.com           # ACME notifications (optional)
PUBLIC_BASE_URL=                         # e.g. https://knowledge.acme.com — used for SSO redirect + email links
TRUSTED_HOSTS=*                          # Host allow-list; comma list, "*" disables the check
FORCE_HTTPS_REDIRECT=false               # in-app http→https (Caddy already does this)

# ── Transactional email (verification / password reset) ────
EMAIL_SENDER=console                     # console | smtp | noop
EMAIL_FROM=no-reply@knowledgedesk.local
EMAIL_PUBLIC_BASE_URL=http://localhost:3000   # base for links in emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ── Subscription entitlements (feature gates) ──────────────
# Comma list, "*" = everything. Per-tenant overrides in tenant settings. Known: sso
ENTITLEMENTS=

# ── Application logging ──────────────────────────────────────
# Every stdlib `logging` call — this app, its dependencies, uvicorn's own
# access/error logs — becomes one structured JSON line with the same
# request_id/tenant/actor as observability events. See docs/LOGGING.md.
LOG_LEVEL=INFO
LOG_FORMAT=json                          # json | text (text is easier to read locally)
LOG_BRIDGE_LEVEL=WARNING                 # WARNING+ log records also become an
                                          # observability "app.log" event, so
                                          # they reach every sink below too.

# ── Observability ──────────────────────────────────────────
# Open, pluggable monitoring. The in-process metric registry is always on; the
# sinks below decide where signals are ALSO sent. See docs/OBSERVABILITY.md.
OBSERVABILITY_ENABLED=true
# comma list: noop | stdout | sqlite | prometheus | webhook | otlp | postgres | mongodb
OBSERVABILITY_SINKS=stdout,sqlite,prometheus
OBSERVABILITY_SERVICE_NAME=knowledgedesk
OBSERVABILITY_SAMPLE_TRACES=1.0          # span sampling 0..1
OBSERVABILITY_MAX_SERIES=2000            # per-metric label-set cap
OBSERVABILITY_HEALTH_PROBE_SECONDS=30    # 0 disables the background dependency probe
OBS_RESOURCE_METRICS_SECONDS=15          # host/process CPU/mem/FD/thread gauges; 0 disables

OBS_STDOUT_PRETTY=false
OBS_STDOUT_METRICS=false                 # metrics are noisy on stdout
OBS_SQLITE_PATH=                         # default {DATA_DIR}/observability.db
OBS_SQLITE_RETENTION_HOURS=168
OBS_PROMETHEUS_PATH=/metrics
OBS_PROMETHEUS_TOKEN=                    # optional bearer required to scrape /metrics
OBS_WEBHOOK_URL=                         # enable the 'webhook' sink
OBS_WEBHOOK_TOKEN=
OBS_WEBHOOK_BATCH=100
OBS_OTLP_ENDPOINT=                       # e.g. http://otel-collector:4318 (enable 'otlp' sink)
OBS_OTLP_HEADERS=                        # "k=v,k2=v2"

# Centralized log collection — SQL / NoSQL, config-selected per deployment.
# Add "postgres" and/or "mongodb" to OBSERVABILITY_SINKS above to enable.
# The bundled docker-compose services are opt-in (compose --profile postgres /
# --profile mongodb); point these at any other Postgres/Mongo instead — a
# customer's own RDS, Atlas, self-hosted, etc.
OBS_POSTGRES_DSN=                        # postgresql://kd:kd@postgres:5432/knowledgedesk
OBS_POSTGRES_TABLE=kd_logs
OBS_POSTGRES_BATCH=50
OBS_MONGO_URI=                           # mongodb://kd:kd@mongodb:27017
OBS_MONGO_DB=knowledgedesk
OBS_MONGO_COLLECTION=logs
OBS_MONGO_BATCH=50
