############################################################
#  KnowledgeDesk v1 — Configuration
#  Every knob lives here. Defaults work out of the box —
#  you don't need to change anything to demo.
############################################################

# ── Identity ────────────────────────────────────────────────
APP_NAME=KnowledgeDesk
ENVIRONMENT=demo                      # demo | production

# ── Security ────────────────────────────────────────────────
ADMIN_API_KEY=kd-admin-key            # CHANGE in production. Manages tenants.
DEMO_TENANT_ENABLED=true              # auto-creates a "demo" tenant at startup
DEMO_TENANT_API_KEY=kd-demo-key       # key the UI uses by default

# Master key for encrypting model-connector credentials (AWS/Azure keys) at rest.
# Leave blank for local/demo → auto-generated & persisted to {DATA_DIR}/secret.key.
# In production supply this from a KMS / secrets manager. Changing it makes
# previously stored connector credentials unreadable (re-enter them).
KD_SECRET_KEY=

# ── Model profile defaults ─────────────────────────────────
# Tenant admins can change this from Settings in the UI.
# premium_best | enterprise_balanced | multilingual_efficient | demo_fast | extractive_zero_llm
MODEL_PROFILE=demo_fast

# ── LLM (answer generation) ─────────────────────────────────
# provider: ollama (local, free) | openai_compatible (any hosted endpoint) | none (extractive answers, no LLM)
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b                   # Balanced: gemma3:12b. Premium/GPU: gemma3:27b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=300                  # MacBook CPU can take longer on first generation
LLM_FALLBACK_TO_EXTRACTIVE=true       # retrieval fallback stays available, but UI now explains the exact LLM issue
OLLAMA_AUTO_PULL_SAFE_MODELS=true     # auto-pull laptop-safe Ollama models if missing
ALLOW_LARGE_OLLAMA_MODELS=false      # true only when you intentionally run 12B/27B+ models

# Only needed when LLM_PROVIDER=openai_compatible (works with OpenAI, Groq, Together, vLLM, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Embeddings ──────────────────────────────────────────────
# provider: local (free, baked into the image) | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2  # Demo-safe. Enterprise: BAAI/bge-m3
EMBEDDING_BATCH_SIZE=64
ALLOW_HEAVY_LOCAL_MODELS=false        # true only on GPU boxes for Qwen 4B embedding/reranker
AUTO_DOWNGRADE_BLOCKED_MODELS=true    # existing premium tenant settings are reset to demo_safe unless heavy models allowed
LAPTOP_SAFE_MODE=true                 # MacBook/16GB safe mode: no optional reranker downloads by default
ALLOW_RERANKER_MODELS=false           # true only when you accept CrossEncoder download/load latency
HF_TOKEN=                             # optional; improves Hugging Face downloads/rate limits

# ── Reranking ───────────────────────────────────────────────
RERANKER_ENABLED=false
RERANKER_MODEL=
RERANK_TOP_K=0

# ── Retrieval ───────────────────────────────────────────────
RETRIEVAL_TOP_K=12                    # first-stage vector retrieval pool
RETRIEVAL_SCORE_THRESHOLD=0.28        # below this similarity → "not found" (logged as a knowledge gap)
RETRIEVAL_MAX_CONTEXT_CHARS=9000     # hard cap on context size

# ── Chunking ────────────────────────────────────────────────
CHUNK_SIZE=1100                       # characters per chunk
CHUNK_OVERLAP=180
MAX_UPLOAD_MB=50

# ── Answer behaviour ────────────────────────────────────────
ANSWER_LANGUAGE=auto                  # auto = mirror the question's language, or force e.g. "English"
ANSWER_REFUSE_OUTSIDE_KNOWLEDGE=true  # LLM must say "I don't know" instead of inventing
ANSWER_INCLUDE_CITATIONS=true

# ── Data connectors ────────────────────────────────────────
# Per-workspace connectors (Google Drive service account, SharePoint) are now
# configured from the app: Administration → Data connectors. Credentials are
# encrypted at rest with KD_SECRET_KEY. The variables below are the LEGACY,
# GLOBAL, single-tenant fallback only — leave blank unless you rely on it.
GDRIVE_ACCESS_TOKEN=                  # legacy: short-lived OAuth token, expires in ~1h
GDRIVE_FOLDER_ID=

MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_SITE_ID=                      # e.g. contoso.sharepoint.com,guid,guid
MSGRAPH_DRIVE_ID=                     # optional; default document library used if blank

# ── Infrastructure (set by docker-compose; rarely touched) ──
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
DATA_DIR=/data

# ── Observability ──────────────────────────────────────────
# Open, pluggable monitoring. The in-process metric registry is always on; the
# sinks below decide where signals are ALSO sent. See docs/OBSERVABILITY.md.
OBSERVABILITY_ENABLED=true
# comma list: noop | stdout | sqlite | prometheus | webhook | otlp
OBSERVABILITY_SINKS=stdout,sqlite,prometheus
OBSERVABILITY_SERVICE_NAME=knowledgedesk
OBSERVABILITY_SAMPLE_TRACES=1.0          # span sampling 0..1
OBSERVABILITY_MAX_SERIES=2000            # per-metric label-set cap
OBSERVABILITY_HEALTH_PROBE_SECONDS=30    # 0 disables the background probe

OBS_STDOUT_PRETTY=false
OBS_STDOUT_METRICS=false                 # metrics are noisy on stdout
OBS_SQLITE_PATH=                         # default {DATA_DIR}/observability.db
OBS_SQLITE_RETENTION_HOURS=168
OBS_PROMETHEUS_PATH=/metrics
OBS_PROMETHEUS_TOKEN=                    # optional bearer required to scrape /metrics
OBS_WEBHOOK_URL=                         # enable the 'webhook' sink
OBS_WEBHOOK_TOKEN=
OBS_WEBHOOK_BATCH=100
OBS_OTLP_ENDPOINT=                       # e.g. http://otel-collector:4318 (enable 'otlp' sink)
OBS_OTLP_HEADERS=                        # "k=v,k2=v2"
